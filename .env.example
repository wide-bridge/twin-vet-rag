# Copy to `.env` in the project root for local overrides (never commit `.env`).
# Precedence (highest first): process environment > project .env > ENV_FILE (external keys file) > defaults in code.

# External secrets file. Only OPENAI_API_KEY is read from it.
ENV_FILE=D:\PyProject\env_keys\.env
OPENAI_API_KEY=

DATABASE_URL=postgresql+psycopg://twinvet:twinvet_local@127.0.0.1:55433/twinvet
TWINVET_DB_PORT=55433
TWINVET_DB_PASSWORD=twinvet_local

AIHUB_DATA_DIR=D:\ai_hub_data
DATA_OUTPUT_DIR=.\data_output

EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-5-mini
LLM_CLASSIFIER_MODEL=gpt-5-nano
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.40

# Sessions and requests
SESSION_TTL_DAYS=7
COOKIE_SECURE=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
QUESTION_MAX_CHARS=1000
QUESTIONS_PER_MINUTE=6
RUN_TIMEOUT_SECONDS=120
WORKER_THREADS=2
ENABLE_SOURCE_EXCERPTS=false

# Dog life stage thresholds (months)
LIFE_STAGE_PUPPY_MAX_MONTHS=12
LIFE_STAGE_SENIOR_MIN_MONTHS=84

# Neon deployment (dedicated project: twin-vet-care; existing table names unchanged)
# Replace only the scheme in Neon URLs with postgresql+psycopg://.
# Keep sslmode=require and any channel_binding parameter supplied by Neon.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# ALEMBIC_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# ALLOWED_ORIGINS=https://YOUR-APP.onrender.com
# Use actual Neon hostnames from Connect, not these placeholders.
