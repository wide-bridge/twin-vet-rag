{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "regions": [
    "sin1"
  ],
  "functions": {
    "index.py": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/review",
      "has": [
        {
          "type": "host",
          "value": "twinvet.pawcheck.ai"
        }
      ],
      "destination": "https://hitl-review.pawcheck.ai/",
      "permanent": false
    },
    {
      "source": "/vet",
      "has": [
        {
          "type": "host",
          "value": "twinvet.pawcheck.ai"
        }
      ],
      "destination": "https://vet.pawcheck.ai/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/review",
      "destination": "/index.html"
    },
    {
      "source": "/vet",
      "destination": "/index.html"
    },
    {
      "source": "/q/:token",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "hitl-review.pawcheck.ai"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vet.pawcheck.ai"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(review|vet|q/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/cleanup",
      "schedule": "0 19 * * *"
    }
  ]
}
