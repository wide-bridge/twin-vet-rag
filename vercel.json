{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "regions": ["sin1"],
  "functions": {
    "index.py": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/review",
      "has": [{ "type": "host", "value": "twinvet.pawcheck.ai" }],
      "destination": "https://vet.pawcheck.ai/",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/review", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "vet.pawcheck.ai" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/review",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
